   "source": [
    "## 9. Risk Analysis: Drawdowns\n",
    "\n",
    "Comparing the drawdown profile of Buy & Hold against the RSI-filtered\n",
    "crossover strategy for every market.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "dc30e7cc",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-24T12:14:26.584405Z",
     "iopub.status.busy": "2026-08-24T12:14:26.584271Z",
     "iopub.status.idle": "2026-08-24T12:14:27.275848Z",
     "shell.execute_reply": "2026-08-24T12:14:27.275338Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x1400 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, axes = plt.subplots(3, 2, figsize=(15, 14))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for ax, name in zip(axes, markets):\n",
    "    for strat_name in [\"Buy & Hold\", \"MA Crossover + RSI Filter\"]:\n",
    "        growth = equity_curves[name][strat_name]\n",
    "        running_max = growth.cummax()\n",
    "        drawdown = (growth - running_max) / running_max * 100\n",
    "        ax.plot(drawdown.index, drawdown, label=strat_name)\n",
    "\n",
    "    ax.set_title(name)\n",
    "    ax.set_xlabel(\"Date\")\n",
    "    ax.set_ylabel(\"Drawdown (%)\")\n",
    "    ax.legend(fontsize=8)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
